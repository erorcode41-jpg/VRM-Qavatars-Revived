{
  "version": "0.4.0",
  "sharedDir": "shared",
  "dependenciesDir": "extern",
  "info": {
    "name": "VRM Qavatars Revived",
    "id": "vrm-qavatars",
    "version": "1.0.0",
    "url": "https://github.com/BSQ-VRM/VRM-Qavatars",
    "additionalData": {
      "overrideSoName": "libvrm-qavatars.so",
      "cmake": true
    }
  },
  "workspace": {
    "scripts": {
      "build": [
        "pwsh ./scripts/build.ps1"
      ],
      "copy": [
        "pwsh ./scripts/copy.ps1"
      ],
      "logcat": [
        "pwsh ./scripts/start-logging.ps1"
      ],
      "qmod": [
        "pwsh ./scripts/build.ps1",
        "pwsh ./scripts/createqmod.ps1"
      ],
      "restart": [
        "pwsh ./scripts/restart-game.ps1"
      ],
      "stack": [
        "pwsh ./scripts/ndk-stack.ps1"
      ],
      "tomb": [
        "pwsh ./scripts/pull-tombstone.ps1"
      ]
    },
    "ndk": "^27.2.12479018",
    "qmodIncludeDirs": [
      "./build",
      "./extern/libs"
    ],
    "qmodIncludeFiles": [
      "./shaders.sbund"
    ],
    "qmodOutput": "./VRM_Qavatars_Revived.qmod"
  },
  "dependencies": [
    {
      "id": "beatsaber-hook",
      "versionRange": "^6.4.2",
      "additionalData": {}
    },
    {
      "id": "bs-cordl",
      "versionRange": "4008.*",
      "additionalData": {}
    },
    {
      "id": "custom-types",
      "versionRange": "^0.18.3",
      "additionalData": {}
    },
    {
      "id": "scotland2",
      "versionRange": "^0.1.6",
      "additionalData": {
        "includeQmod": false
      }
    },
    {
      "id": "paper2_scotland2",
      "versionRange": "^4.6.4",
      "additionalData": {}
    },
    {
      "id": "bsml",
      "versionRange": "^0.4.55",
      "additionalData": {}
    },
    {
      "id": "assimp",
      "versionRange": "^5.3.3",
      "additionalData": {}
    },
    {
      "id": "sombrero",
      "versionRange": "^0.1.37",
      "additionalData": {}
    },
    {
      "id": "fmt",
      "versionRange": "^11.0.2",
      "additionalData": {}
    },
    {
      "id": "rapidjson-macros",
      "versionRange": "*",
      "additionalData": {}
    }
  ]
}